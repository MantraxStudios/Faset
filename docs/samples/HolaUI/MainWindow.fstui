<Window Class="MainWindow" Namespace="HolaUI" Title="HolaUI" Width="560" Height="380" Theme="Dark">
  <Label Name="lblTitle" X="32" Y="28" Width="496" Height="34" Text="Hello, Faset" FontSize="24" Bold="true" Anchor="Left,Top,Right" />
  <Label Name="lblSubtitle" X="32" Y="62" Width="496" Height="22" Text="Edit MainWindow.fstui in the FasetStudio designer." Style="Subtle" Anchor="Left,Top,Right" />
  <Panel Name="card" X="32" Y="104" Width="496" Height="180" Anchor="Left,Top,Right,Bottom">
    <Label X="20" Y="16" Width="200" Height="20" Text="Your name" FontSize="13" Style="Subtle" />
    <TextBox Name="txtName" X="20" Y="40" Width="456" Height="36" Placeholder="Type your name..." Anchor="Left,Top,Right" Changed="OnNameChanged" />
    <CheckBox Name="chkExcited" X="20" Y="92" Width="240" Height="24" Text="Add excitement" Changed="OnNameChanged" />
    <Slider Name="sldVolume" X="20" Y="130" Width="300" Height="24" Value="30" Changed="OnVolumeChanged" />
    <ProgressBar Name="prgVolume" X="336" Y="139" Width="140" Height="6" Value="30" Anchor="Left,Top,Right" />
  </Panel>
  <Button Name="btnClose" X="300" Y="312" Width="108" Height="38" Text="Close" Anchor="Right,Bottom" Click="OnCloseClick" />
  <Button Name="btnGreet" X="420" Y="312" Width="108" Height="38" Text="Greet" Style="Primary" Anchor="Right,Bottom" Click="OnGreetClick" />
</Window>
